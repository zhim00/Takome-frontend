# 前端 novel 镜像：只打包静态产物，不在镜像内构建。
#
# 构建前必须先在开发机（或任意能正常运行 pnpm 的机器）生成产物：
#   corepack enable
#   pnpm install --frozen-lockfile
#   pnpm build:novel
#
# 产物目录 apps/novel/dist 必须存在，否则下面的 COPY 会直接失败。
# API 地址取自 apps/novel/.env.production，在 build 时就编译进产物，
# 所以这里不需要 ARG/ENV，compose 的 build 段也不需要 args。

FROM caddy:2-alpine

COPY apps/novel/dist/ /usr/share/caddy/